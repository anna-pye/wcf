/**
 * Implements hook_form_alter().
 */
function wcf_theme_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if (str_starts_with($form_id, 'node_') && str_ends_with($form_id, '_form')) {
    if (isset($form['revision_log'])) {
      $form['revision_log']['#description'] = t('Describe what changed in this revision. This helps editors track editorial updates.');
    }
    if (isset($form['moderation_state'])) {
      $form['moderation_state']['#description'] = t('Draft: work in progress. In review: ready for an editor. Published: live on the site.');
    }
    wcf_theme_apply_editorial_field_help($form, $form_state);
  }

  if (in_array($form_id, ['media_image_add_form', 'media_image_edit_form'], TRUE)) {
    wcf_theme_media_image_form_add_upload_validators($form);
  }

  if ($form_id === 'views_exposed_form' && isset($form['stallion_category'])) {
    wcf_theme_limit_stallion_listing_category_options($form);
    wcf_theme_stallion_listing_exposed_form_alter($form);
  }

  if ($form_id === 'views_exposed_form' && isset($form['#id']) && str_contains((string) $form['#id'], 'search-stallions')) {
    $form['#attributes']['class'][] = 'site-search__form';
    $form['#attributes']['class'][] = 'site-search__form--inline';
    $form['#attributes']['role'] = 'search';
    $form['#attributes']['aria-label'] = t('Keyword search');
    if (isset($form['keywords'])) {
      $form['keywords']['#title_display'] = 'invisible';
      $form['keywords']['#attributes']['placeholder'] = t('Search by keyword');
      $form['keywords']['#attributes']['class'][] = 'site-search__input';
      $form['keywords']['#description_display'] = 'invisible';
      unset($form['keywords']['#description']);
    }
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['class'][] = 'button--primary';
      $form['actions']['submit']['#attributes']['class'][] = 'site-search__submit';
      $form['actions']['submit']['#value'] = t('Search');
    }
    if (isset($form['actions']['reset'])) {
      $form['actions']['reset']['#attributes']['class'][] = 'button--outline';
      $form['actions']['reset']['#attributes']['class'][] = 'site-search__reset';
    }
  }
}

/**
 * Ensures media image uploads are readable by GD/ImageMagick (blocks mislabeled HEIC).
 */
function wcf_theme_media_image_form_add_upload_validators(array &$form): void {
  if (!isset($form['field_media_image']['widget'][0]['#upload_validators'])) {
    return;
  }
  $form['field_media_image']['widget'][0]['#upload_validators']['FileIsImage'] = [];
  if (isset($form['field_media_image']['widget'][0]['#description'])) {
    $form['field_media_image']['widget'][0]['#description'] .= ' ' . t('Use JPEG, PNG, or WebP only. Convert HEIC/iPhone photos before uploading.');
  }
  else {
    $form['field_media_image']['widget'][0]['#description'] = t('Use JPEG, PNG, or WebP only. Convert HEIC/iPhone photos before uploading.');
  }
}

/**
 * Adds concise editorial help on governed node forms.
 */
function wcf_theme_apply_editorial_field_help(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!is_object($form_object) || !method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();
  if (!$entity instanceof NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();
  if (!in_array($bundle, ['stallion', 'container_home', 'article', 'wcf_ad_banner', 'wcf_registry_logo', 'wcf_newsletter', 'wcf_showcase_item'], TRUE)) {
    return;
  }

  if (isset($form['field_status'])) {
    $form['field_status']['#description'] = t('Lifecycle only: active, sold, or retired. Do not use categories for sale status.');
  }
  if (isset($form['field_category'])) {
    $form['field_category']['#description'] = t('Choose one governed category from the list.');
  }
  if (isset($form['field_featured'])) {
    $form['field_featured']['#description'] = t('Promotes this stallion in featured listings and sort order. Not a replacement for categories or status.');
  }
  if (isset($form['body'])) {
    $form['body']['#description'] = t('Summary is used on cards, search, and social previews. Leave blank only when body text will supply a trimmed fallback.');
    if (isset($form['body']['widget'][0]['summary']['#description'])) {
      $form['body']['widget'][0]['summary']['#description'] = t('Write a short editorial summary. Remediation scripts never overwrite an existing summary.');
    }
  }
  if (isset($form['path'])) {
    $form['path']['#description'] = t('URL alias is the canonical public path. Avoid duplicate titles; use Pathauto patterns when unsure.');
  }
  if ($bundle === 'container_home' && isset($form['field_sold'])) {
    $form['field_sold']['#description'] = t('Marks this container home as sold. Use this flag instead of taxonomy for sold inventory.');
  }
  if ($bundle === 'wcf_registry_logo') {
    if (isset($form['field_registry_logo'])) {
      $form['field_registry_logo']['#description'] = t('Upload only client-approved logos via Media. See docs/registry-logo-editorial-guidance.md.');
    }
    if (isset($form['field_registry_colour'])) {
      $form['field_registry_colour']['#description'] = t('Placeholder swatch colour when no logo image is uploaded.');
    }
    if (isset($form['field_registry_link'])) {
      $form['field_registry_link']['#description'] = t('Optional official website. The homepage card links only when this URL is accessible.');
    }
    if (isset($form['field_registry_weight'])) {
      $form['field_registry_weight']['#description'] = t('Lower numbers appear first. Up to five published registry logos display on the homepage.');
    }
  }
  if ($bundle === 'wcf_newsletter') {
    if (isset($form['field_newsletter_file'])) {
      $form['field_newsletter_file']['#description'] = t('Upload the monthly newsletter PDF via Document media.');
    }
    if (isset($form['field_newsletter_year'])) {
      $form['field_newsletter_year']['#description'] = t('Used to group issues on the News page (/news).');
    }
    if (isset($form['field_newsletter_month'])) {
      $form['field_newsletter_month']['#description'] = t('Public link label (e.g. January, April).');
    }
    if (isset($form['field_newsletter_weight'])) {
      $form['field_newsletter_weight']['#description'] = t('Sort order within the same year (lower appears first).');
    }
  }
  if ($bundle === 'wcf_ad_banner') {
    if (isset($form['field_banner_image'])) {
      $form['field_banner_image']['#description'] = t('Upload or select a JPEG, PNG, or WebP banner from the Media Library. HEIC and other phone formats must be converted before upload.');
    }
    if (isset($form['field_banner_link'])) {
      $form['field_banner_link']['#description'] = t('Destination when the banner is clicked. Internal pages and external URLs are supported.');
    }
    if (isset($form['field_banner_categories'])) {
      $form['field_banner_categories']['#description'] = t('Select one or more categories. The banner appears on stallion and container home pages that share a category. Leave empty to hide on all pages.');
    }
    if (isset($form['field_banner_weight'])) {
      $form['field_banner_weight']['#description'] = t('Lower numbers appear first. Up to four banners show per page.');
    }
    if (isset($form['field_banner_caption'])) {
      $form['field_banner_caption']['#description'] = t('Optional caption below the image. Also used for screen reader link text when set.');
    }
  }
}

/**
 * Implements hook_theme().
 */
function wcf_theme_theme(): array {
  return [
    'wcf_ad_banner_card' => [
      'variables' => [
        'banner_link' => NULL,
      ],
      'template' => 'wcf-ad-banner-card',
    ],
  ];
}

/**
 * Implements hook_preprocess_page().
 */
function wcf_theme_preprocess_page(array &$variables): void {
  $site_config = \Drupal::config('system.site');
  $variables['site_mail'] = $site_config->get('mail');
  wcf_theme_attach_chrome_variables($variables);
  wcf_theme_attach_public_footer_variables($variables);

  // Mockup-aligned primary nav in the header (all public pages).
  $variables['wcf_show_front_nav'] = TRUE;
  $variables['wcf_front_nav_links'] = wcf_theme_build_front_nav_links();

  if (!empty($variables['is_front'])) {
    $variables['#attached']['library'][] = 'wcf_theme/global';
    wcf_theme_attach_homepage_variables($variables);
  }
}

/**
 * Removes featured stallions paragraphs from homepage feature section output.
 */
function wcf_theme_strip_homepage_featured_stallions(array &$variables): void {
  if (!isset($variables['content']['field_feature_sections']) || !is_array($variables['content']['field_feature_sections'])) {
    return;
  }

  $build = &$variables['content']['field_feature_sections'];
  foreach (Element::children($build) as $delta) {
    $paragraph = $build[$delta]['#paragraph'] ?? NULL;
    if ($paragraph instanceof ParagraphInterface && $paragraph->bundle() === 'featured_stallions') {
      unset($build[$delta]);
    }
  }
}

/**
 * Implements hook_preprocess_node__homepage().
 */
function wcf_theme_preprocess_node__homepage(array &$variables): void {
  $variables['#attached']['library'][] = 'wcf_theme/global';
  wcf_theme_attach_chrome_variables($variables);
  wcf_theme_strip_homepage_featured_stallions($variables);
}

/**
 * Groups footer menu links into D7-style columns for menu--footer.html.twig.
 *
 * Maps known link titles to column buckets; unmapped items fall into Site.
 */
function wcf_theme_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'footer' || empty($variables['items'])) {
    return;
  }

  $column_defs = [
    'stallions' => [
      'title' => (string) t('Stallions'),
      'titles' => ['Stallions', 'Search'],
    ],
    'site' => [
      'title' => (string) t('Site'),
      'titles' => ['Home', 'Contact'],
    ],
    'services' => [
      'title' => (string) t('Services'),
      'titles' => ['Nomination', 'Facebook'],
    ],
  ];

  $columns = [];
  foreach ($column_defs as $id => $def) {
    $columns[$id] = [
      'title' => $def['title'],
      'items' => [],
    ];
  }

  foreach ($variables['items'] as $key => $item) {
    $title = trim((string) $item['title']);
    $placed = FALSE;
    foreach ($column_defs as $id => $def) {
      if (in_array($title, $def['titles'], TRUE)) {
        $columns[$id]['items'][$key] = $item;
        $placed = TRUE;
        break;
      }
    }
    if (!$placed) {
      $columns['site']['items'][$key] = $item;
    }
  }

  $variables['footer_menu_columns'] = array_values(array_filter(
    $columns,
    static fn(array $column): bool => $column['items'] !== [],
  ));
}
