/**
 * Canonical WCF Instagram profile URL (optional third-party link).
 */
function wcf_theme_instagram_page_url(): ?string {
  return 'https://www.instagram.com/winningcoloursfarm/';
}

/**
 * Bundles that support category-aware ad banner placement.
 *
 * @return list<string>
 */
function wcf_theme_ad_banner_host_bundles(): array {
  return ['stallion', 'container_home'];
}

/**
 * Loads a published categories term by exact label (case-insensitive).
 */
function wcf_theme_load_category_term_by_name(string $name): ?TermInterface {
  $key = mb_strtolower(trim($name));
  if ($key === '') {
    return NULL;
  }

  static $cache = [];
  if (array_key_exists($key, $cache)) {
    return $cache[$key];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'categories')
    ->condition('status', 1)
    ->execute();

  $cache[$key] = NULL;
  if ($tids === []) {
    return NULL;
  }

  /** @var \Drupal\taxonomy\TermInterface[] $terms */
  $terms = $storage->loadMultiple($tids);
  foreach ($terms as $term) {
    if ($term instanceof TermInterface && mb_strtolower(trim($term->label())) === $key) {
      $cache[$key] = $term;
      break;
    }
  }

  return $cache[$key];
}

/**
 * Builds a /search URL filtered by stallion lifecycle status (Search API facet).
 */
function wcf_theme_build_stallion_status_search_url(string $status): ?string {
  return wcf_theme_safe_internal_url('/search', [
    'query' => ['f' => ['stallion_status:' . $status]],
  ]);
}

/**
 * Builds /stallions listing URL with Views exposed filters.
 *
 * @param string|null $category_name
 *   Governed category label (e.g. "Stallions", "ASB Stallions"); NULL for unfiltered.
 */
function wcf_theme_build_stallions_listing_url(?string $category_name = NULL, string $status = 'active'): ?string {
  $query = ['stallion_status' => $status];
  if ($category_name !== NULL && $category_name !== '') {
    $term = wcf_theme_load_category_term_by_name($category_name);
    if ($term === NULL) {
      return NULL;
    }
    $query['stallion_category'] = (string) $term->id();
  }

  return wcf_theme_safe_route_url('view.stallions.page_1', [], ['query' => $query])
    ?? wcf_theme_safe_internal_url('/stallions', ['query' => $query]);
}

/**
 * Builds a /search URL with category and stallion_status facets.
 */
function wcf_theme_build_category_and_status_search_url(string $category_name, string $status = 'active'): ?string {
  if ($category_name === 'For Sale') {
    return wcf_theme_build_stallion_status_search_url($status);
  }

  $term = wcf_theme_load_category_term_by_name($category_name);
  if ($term === NULL) {
    return NULL;
  }

  return wcf_theme_safe_internal_url('/search', [
    'query' => [
      'f' => [
        'category:' . $term->id(),
        'stallion_status:' . $status,
      ],
    ],
  ]);
}

/**
 * Builds a /search URL with multiple category facets and stallion_status.
 *
 * @param list<string> $category_names
 *   Governed category labels (e.g. "ASB Stallions", "Stallions").
 */
function wcf_theme_build_categories_and_status_search_url(array $category_names, string $status = 'active'): ?string {
  $facets = [];
  foreach ($category_names as $category_name) {
    $term = wcf_theme_load_category_term_by_name($category_name);
    if ($term === NULL) {
      return NULL;
    }
    $facets[] = 'category:' . $term->id();
  }
  $facets[] = 'stallion_status:' . $status;

  return wcf_theme_safe_internal_url('/search', [
    'query' => ['f' => $facets],
  ]);
}

/**
 * Builds a /search URL with a category facet for a governed term name.
 */
function wcf_theme_build_category_search_url(string $category_name): ?string {
  // D7 for-sale listings used sold = 0; legacy category_id=2 is entirely sold=1.
  if ($category_name === 'For Sale') {
    return wcf_theme_build_stallion_status_search_url('active');
  }

  $term = wcf_theme_load_category_term_by_name($category_name);
  if ($term === NULL) {
    return NULL;
  }

  return wcf_theme_safe_internal_url('/search', [
    'query' => ['f' => ['category:' . $term->id()]],
  ]);
}

/**
 * Builds a /search link filtered by category facet for a governed term name.
 *
 * @param list<string> $classes
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_category_search_link(string $category_name, string $title, array $classes = []): ?array {
  if ($category_name === 'For Sale') {
    return wcf_theme_build_internal_path_link('/search', $title, $classes, [
      'query' => ['f' => ['stallion_status:active']],
    ]);
  }

  $term = wcf_theme_load_category_term_by_name($category_name);
  if ($term === NULL) {
    return NULL;
  }

  $link = wcf_theme_build_internal_path_link('/search', $title, $classes, [
    'query' => ['f' => ['category:' . $term->id()]],
  ]);
  if ($link !== NULL) {
    $link['#cache']['tags'] = Cache::mergeTags(
      $link['#cache']['tags'] ?? [],
      $term->getCacheTags(),
    );
  }

  return $link;
}

/**
 * Returns the category term ID for nodes that expose field_category.
 */
function wcf_theme_get_node_category_term_id(NodeInterface $node): ?int {
  if (!in_array($node->bundle(), wcf_theme_ad_banner_host_bundles(), TRUE)) {
    return NULL;
  }
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return NULL;
  }
  $term = $node->get('field_category')->entity;
  return $term !== NULL ? (int) $term->id() : NULL;
}

/**
 * Whether an image file has readable dimensions for responsive srcset building.
 */
function wcf_theme_image_uri_has_dimensions(string $uri): bool {
  $image = \Drupal::service('image.factory')->get($uri);
  return $image->isValid() && (int) $image->getWidth() > 0 && (int) $image->getHeight() > 0;
}

/**
 * Whether a media image can be scaled for display (JPEG, PNG, WebP, etc.).
 *
 * Rejects mislabeled files (e.g. HEIC saved with a .png extension) that break
 * image style and responsive image rendering.
 */
function wcf_theme_media_image_is_renderable(MediaInterface $media): bool {
  if ($media->bundle() !== 'image' || $media->get('field_media_image')->isEmpty()) {
    return FALSE;
  }

  $item = $media->get('field_media_image')->first();
  if ($item === NULL || empty($item->uri)) {
    return FALSE;
  }

  return wcf_theme_image_uri_has_dimensions($item->uri);
}

/**
 * Implements hook_preprocess_responsive_image_formatter().
 *
 * Falls back to a single styled image when the source file cannot be measured.
 * Prevents LogicException from responsive_image "sizes" mappings on corrupt or
 * mislabeled uploads (e.g. HEIC saved with a .png extension).
 */
function wcf_theme_preprocess_responsive_image_formatter(array &$variables): void {
  $item = $variables['item'] ?? NULL;
  if ($item === NULL) {
    return;
  }

  $uri = NULL;
  if (!empty($item->entity) && empty($item->uri)) {
    $uri = $item->entity->getFileUri();
  }
  elseif (!empty($item->uri)) {
    $uri = $item->uri;
  }
  if ($uri === NULL || $uri === '') {
    return;
  }

  if (wcf_theme_image_uri_has_dimensions($uri)) {
    return;
  }

  $style_id = $variables['responsive_image_style_id'] ?? '';
  $fallback_style = 'thumbnail';
  $responsive_style = is_string($style_id) && $style_id !== ''
    ? ResponsiveImageStyle::load($style_id)
    : NULL;
  if ($responsive_style instanceof ResponsiveImageStyle) {
    $fallback_style = $responsive_style->getFallbackImageStyle();
  }

  \Drupal::logger('wcf_theme')->warning(
    'Responsive image skipped for unreadable file @uri (style @style); using fallback @fallback.',
    [
      '@uri' => $uri,
      '@style' => $style_id,
      '@fallback' => $fallback_style,
    ],
  );

  $attributes = $variables['attributes'] ?? [];
  if (!empty($variables['item_attributes'])) {
    $attributes = array_merge($attributes, $variables['item_attributes']);
  }
  if (!is_null($item->title) && mb_strlen((string) $item->title) !== 0) {
    $attributes['title'] = $item->title;
  }
  $attributes['alt'] = $item->alt ?? '';

  $variables['responsive_image'] = [
    '#theme' => 'image_style',
    '#uri' => $uri,
    '#style_name' => $fallback_style,
    '#attributes' => $attributes,
  ];
}

/**
 * Builds a clickable ad banner card render array for the banner view mode.
 *
 * @return array<string, mixed>|null
 *   Card render array or NULL when required data or access is missing.
 */
function wcf_theme_build_ad_banner_card(NodeInterface $banner): ?array {
  if ($banner->bundle() !== 'wcf_ad_banner' || !$banner->isPublished()) {
    return NULL;
  }
  if (!$banner->access('view')) {
    return NULL;
  }
  if ($banner->get('field_banner_link')->isEmpty() || $banner->get('field_banner_image')->isEmpty()) {
    return NULL;
  }

  $link_item = $banner->get('field_banner_link')->first();
  if ($link_item === NULL) {
    return NULL;
  }

  $url = $link_item->getUrl();
  if ($url->isRouted() && !$url->access()) {
    return NULL;
  }

  $media = $banner->get('field_banner_image')->entity;
  if (!$media instanceof MediaInterface) {
    return NULL;
  }
  if (!wcf_theme_media_image_is_renderable($media)) {
    \Drupal::logger('wcf_theme')->warning('Skipping ad banner @nid: media @mid image is not a supported web format.', [
      '@nid' => $banner->id(),
      '@mid' => $media->id(),
    ]);
    return NULL;
  }

  $image = \Drupal::entityTypeManager()->getViewBuilder('media')->view($media, 'banner');

  $caption_raw = $banner->get('field_banner_caption')->value;
  $aria_label = ($caption_raw !== NULL && $caption_raw !== '')
    ? $caption_raw
    : (string) t('Promotional banner');

  $link = [
    '#type' => 'link',
    '#title' => $image,
    '#url' => $url,
    '#attributes' => [
      'class' => ['wcf-ad-banner__link'],
      'aria-label' => $aria_label,
    ],
  ];

  return [
    '#theme' => 'wcf_ad_banner_card',
    '#banner_link' => $link,
    '#cache' => [
      'tags' => Cache::mergeTags($banner->getCacheTags(), $media->getCacheTags()),
      'contexts' => ['user.permissions', 'languages:language_interface'],
    ],
  ];
}

/**
 * Loads published ad banner node IDs for a category term.
 *
 * @return list<int|string>
 */
function wcf_theme_load_ad_banner_nids(int $category_tid): array {
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'wcf_ad_banner')
    ->condition('status', 1)
    ->condition('field_banner_categories', $category_tid)
    ->sort('field_banner_weight', 'ASC')
    ->sort('created', 'DESC')
    ->range(0, 4)
    ->execute();

  return array_values($nids);
}

/**
 * Builds the ad banners grid render array for a host node, or NULL when empty.
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_ad_banners_renderable(NodeInterface $node): ?array {
  $category_tid = wcf_theme_get_node_category_term_id($node);
  if ($category_tid === NULL) {
    return NULL;
  }

  $nids = wcf_theme_load_ad_banner_nids($category_tid);
  if ($nids === []) {
    return NULL;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $banners = $storage->loadMultiple($nids);
  $items = [];
  $cache_tags = [
    'node_list:wcf_ad_banner',
    'taxonomy_term:' . $category_tid,
    'node:' . $node->id(),
  ];

  foreach ($nids as $nid) {
    if (!isset($banners[$nid])) {
      continue;
    }
    $card = wcf_theme_build_ad_banner_card($banners[$nid]);
    if ($card === NULL) {
      continue;
    }
    $items[] = $card;
    $cache_tags = Cache::mergeTags($cache_tags, $banners[$nid]->getCacheTags());
  }

  if ($items === []) {
    return NULL;
  }

  $build = [
    '#type' => 'container',
    '#attributes' => ['class' => ['wcf-ad-banners__stack']],
    '#cache' => [
      'tags' => $cache_tags,
      'contexts' => ['route', 'user.permissions', 'languages:language_interface'],
    ],
  ];
  foreach ($items as $delta => $item) {
    $build[$delta] = $item;
  }

  return $build;
}

/**
 * Attaches category-aware ad banners for supported full-page host nodes.
 */
function wcf_theme_attach_ad_banners(array &$variables, NodeInterface $node): void {
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $variables['wcf_ad_banners'] = wcf_theme_build_ad_banners_renderable($node);
}

/**
 * Builds a cacheable stallions View render array.
 *
 * @return array<string, mixed>|null
 *   View render array or NULL when the view is unavailable.
 */
function wcf_theme_build_stallions_view_renderable(string $display_id, ?int $items_per_page = NULL): ?array {
  $view = Views::getView('stallions');
  if (!$view instanceof ViewExecutable) {
    return NULL;
  }

  $view->setDisplay($display_id);
  if ($items_per_page !== NULL) {
    $view->setItemsPerPage($items_per_page);
  }

  $build = $view->buildRenderable($display_id, []);
  return $build === [] ? NULL : $build;
}

/**
 * Builds a cacheable featured content View render array filtered by bundle.
 *
 * @return array<string, mixed>|null
 *   View render array or NULL when the view is unavailable.
 */
function wcf_theme_build_featured_content_view_renderable(string $content_type, int $items_per_page): ?array {
  $display_id = 'block_' . $content_type;
  $view = Views::getView('featured_content');
  if (!$view instanceof ViewExecutable) {
    return NULL;
  }
  $displays = $view->storage->get('display');
  if (!isset($displays[$display_id])) {
    return NULL;
  }
  $view->setDisplay($display_id);

  $view->setItemsPerPage($items_per_page);
  $build = $view->buildRenderable($display_id, []);
  return $build === [] ? NULL : $build;
}

/**
 * Returns a display summary without overwriting stored body summary.
 *
 * Uses the editorial summary when present; otherwise trims body text for cards,
 * metatags, and social previews without writing to the node.
 */
function wcf_theme_node_summary_fallback(NodeInterface $node, int $trim_length = 300): ?string {
  if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
    return NULL;
  }

  $body = $node->get('body');
  $summary = trim((string) $body->summary);
  if ($summary !== '') {
    return NULL;
  }

  $value = (string) $body->value;
  if (trim(strip_tags($value)) === '') {
    return NULL;
  }

  $format = $body->format ?: filter_default_format();
  return text_summary($value, $format, $trim_length);
}

/**
 * Stallion-only wrapper for summary fallback (metatags, cards).
 */
function wcf_theme_stallion_summary_fallback(NodeInterface $node, int $trim_length = 300): ?string {
  if ($node->bundle() !== 'stallion') {
    return NULL;
  }
  return wcf_theme_node_summary_fallback($node, $trim_length);
}

/**
 * Implements hook_metatags_alter().
 */
function wcf_theme_metatags_alter(array &$metatags, array &$context): void {
  $entity = $context['entity'] ?? NULL;
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'stallion') {
    return;
  }

  $fallback = wcf_theme_stallion_summary_fallback($entity);
  if ($fallback === NULL) {
    return;
  }

  foreach (['description', 'og_description', 'twitter_cards_description'] as $tag) {
    if (!isset($metatags[$tag])) {
      continue;
    }
    $configured = is_array($metatags[$tag])
      ? (string) ($metatags[$tag]['value'] ?? $metatags[$tag]['#value'] ?? '')
      : (string) $metatags[$tag];
    if ($configured === '' || $configured === '[node:summary]') {
      $metatags[$tag] = $fallback;
    }
  }
}

/**
 * Status label for stallion cards (search maps active → "For Sale").
 */
function wcf_theme_stallion_card_status_label(NodeInterface $node, string $view_mode): ?string {
  if ($view_mode === 'full') {
    return NULL;
  }

  if (wcf_theme_stallion_is_sold($node)) {
    return NULL;
  }

  if (!in_array($view_mode, ['card', 'teaser'], TRUE)) {
    return wcf_theme_list_field_label($node, 'field_status');
  }

  if (wcf_theme_is_site_search_page()
    && $node->hasField('field_status')
    && !$node->get('field_status')->isEmpty()
    && $node->get('field_status')->value === 'active') {
    return (string) t('For Sale');
  }

  return wcf_theme_list_field_label($node, 'field_status');
}

/**
 * Returns a list field label for display.
 */
function wcf_theme_list_field_label(NodeInterface $node, string $field_name): ?string {
  if ($node->get($field_name)->isEmpty()) {
    return NULL;
  }
  $item = $node->get($field_name)->first();
  if ($item === NULL) {
    return NULL;
  }
  $definition = $node->getFieldDefinition($field_name);
  $allowed = $definition->getSetting('allowed_values') ?? [];
  $value = $item->value;
  return $allowed[$value] ?? $value;
}

/**
 * Implements hook_preprocess_paragraph__hero_slide().
 */
function wcf_theme_preprocess_paragraph__hero_slide(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }

  $cta = wcf_theme_build_paragraph_cta_link($paragraph);
  if ($cta !== NULL) {
    $cta['#attributes']['class'] = ['hero-slide__cta', 'button', 'button--primary'];
    $variables['cta_link'] = $cta;
  }
}

/**
 * Implements hook_preprocess_paragraph__feature_card().
 */
function wcf_theme_preprocess_paragraph__feature_card(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }

  $variables['feature_card_title'] = $paragraph->get('field_title')->value;
  $variables['cta_link'] = wcf_theme_build_paragraph_cta_link($paragraph);
}

/**
 * Implements hook_preprocess_paragraph__featured_content().
 */
function wcf_theme_preprocess_paragraph__featured_content(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }

  $content_type = $paragraph->get('field_content_type')->value;
  if ($content_type === NULL || $content_type === '') {
    return;
  }

  $limit_raw = $paragraph->get('field_item_limit')->value;
  $limit = $limit_raw !== NULL && $limit_raw !== '' ? (int) $limit_raw : 3;
  $limit = max(1, min(12, $limit));

  $variables['featured_content_title'] = $paragraph->get('field_title')->value;
  $variables['featured_content_listing'] = wcf_theme_build_featured_content_view_renderable($content_type, $limit);
}

/**
 * Implements hook_preprocess_paragraph__featured_stallions().
 */
function wcf_theme_preprocess_paragraph__featured_stallions(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }

  $count_raw = $paragraph->get('field_featured_count')->value;
  $count = $count_raw !== NULL && $count_raw !== '' ? (int) $count_raw : 3;
  $count = max(1, min(12, $count));

  $variables['featured_stallions_title'] = $paragraph->get('field_title')->value;
  $variables['featured_stallions_listing'] = wcf_theme_build_stallions_view_renderable('block_featured', $count);
}

/**
 * Implements hook_preprocess_paragraph__testimonial_item().
 */
function wcf_theme_preprocess_paragraph__testimonial_item(array &$variables): void {
  $paragraph = $variables['paragraph'] ?? NULL;
  if (!$paragraph instanceof ParagraphInterface) {
    return;
  }

  $quote_raw = $paragraph->get('field_quote')->value;
  $variables['testimonial_quote'] = $quote_raw !== NULL ? strip_tags($quote_raw) : NULL;
  $variables['testimonial_author_name'] = $paragraph->get('field_author_name')->value;
  $variables['testimonial_author_role'] = $paragraph->get('field_author_role')->value;
}

/**
 * Public URL for the stallion "image coming soon" placeholder asset.
 */
function wcf_theme_stallion_placeholder_image_url(): string {
  return base_path() . \Drupal::theme()->getActiveTheme()->getPath() . '/images/placeholder-horse.png';
}

/**
 * Public URL for the sold overlay badge on stallion main images.
 */
function wcf_theme_stallion_sold_badge_image_url(): string {
  return base_path() . \Drupal::theme()->getActiveTheme()->getPath() . '/images/sold-badge.png';
}

/**
 * Whether the stallion should show the sold badge (matches search cards).
 */
function wcf_theme_stallion_is_sold(NodeInterface $node): bool {
  if ($node->bundle() !== 'stallion') {
    return FALSE;
  }

  if ($node->hasField('field_status') && !$node->get('field_status')->isEmpty()) {
    if ($node->get('field_status')->value === 'sold') {
      return TRUE;
    }
  }

  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term instanceof TermInterface) {
      $label = mb_strtolower(trim($term->label()));
      if (in_array($label, ['sold', 'sold stallions'], TRUE)) {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Builds document link rows for the stallion full-page documents field.
 *
 * @return list<array{label: string, url: string}>
 */
function wcf_theme_stallion_document_items(NodeInterface $node): array {
  if (!$node->hasField('field_documents') || $node->get('field_documents')->isEmpty()) {
    return [];
  }

  $items = [];
  $file_url_generator = \Drupal::service('file_url_generator');
  foreach ($node->get('field_documents') as $reference) {
    $media = $reference->entity;
    if ($media === NULL || $media->bundle() !== 'document') {
      continue;
    }
    if ($media->get('field_media_document')->isEmpty()) {
      continue;
    }
    $file = $media->get('field_media_document')->entity;
    if ($file === NULL) {
      continue;
    }
    $label = trim($media->label());
    if ($label === '') {
      $label = $file->getFilename();
    }
    $items[] = [
      'label' => $label,
      'url' => $file_url_generator->generateAbsoluteString($file->getFileUri()),
    ];
  }

  return $items;
}

/**
 * Builds video rows for the stallion full-page videos section.
 *
 * @return list<array{label: string, url: string, thumbnail: string|null}>
 */
function wcf_theme_stallion_video_items(NodeInterface $node): array {
  if (!$node->hasField('field_video') || $node->get('field_video')->isEmpty()) {
    return [];
  }

  $file_url_generator = \Drupal::service('file_url_generator');
  $items = [];
  foreach ($node->get('field_video') as $reference) {
    $media = $reference->entity;
    if ($media === NULL || $media->bundle() !== 'remote_video') {
      continue;
    }
    if ($media->get('field_media_oembed_video')->isEmpty()) {
      continue;
    }
    $video_url = trim((string) $media->get('field_media_oembed_video')->value);
    if ($video_url === '') {
      continue;
    }

    $label = trim($media->label());
    if ($label === '') {
      $label = (string) t('Video');
    }

    $thumbnail = NULL;
    if (!$media->get('thumbnail')->isEmpty()) {
      $thumb_file = $media->get('thumbnail')->entity;
      if ($thumb_file !== NULL) {
        $thumbnail = $file_url_generator->generateAbsoluteString($thumb_file->getFileUri());
      }
    }

    $items[] = [
      'label' => $label,
      'url' => $video_url,
      'thumbnail' => $thumbnail,
    ];
  }

  return $items;
}

/**
 * Whether the stallion is in the Foals category.
 */
function wcf_theme_stallion_is_foals(NodeInterface $node): bool {
  if (!$node->hasField('field_category') || $node->get('field_category')->isEmpty()) {
    return FALSE;
  }
  $term = $node->get('field_category')->entity;
  return $term !== NULL && $term->label() === 'Foals';
}

/**
 * Returns the foal year for a stallion (field value or title prefix).
 */
function wcf_theme_stallion_foal_year(NodeInterface $node): ?int {
  if ($node->hasField('field_foal_year') && !$node->get('field_foal_year')->isEmpty()) {
    return (int) $node->get('field_foal_year')->value;
  }
  if (preg_match('/^\s*(\d{4})\b/', $node->label(), $matches) === 1) {
    return (int) $matches[1];
  }
  return NULL;
}

/**
 * Breed / sex line for cards (node title without leading year).
 */
function wcf_theme_stallion_card_detail_line(NodeInterface $node): ?string {
  $label = trim($node->label());
  if ($label === '') {
    return NULL;
  }
  if (preg_match('/^\s*\d{4}\s+(.+)$/s', $label, $matches) === 1) {
    return trim($matches[1]);
  }
  return $label;
}

/**
 * Active foal year from search facet query (f[]=foal_year:YYYY or foal_year param).
 */
function wcf_theme_search_active_foal_year(): ?int {
  $request = \Drupal::request();
  $foal_year = $request->query->get('foal_year');
  if (is_numeric($foal_year)) {
    return (int) $foal_year;
  }
  $filters = $request->query->all('f');
  if (!is_array($filters)) {
    return NULL;
  }
  foreach ($filters as $filter) {
    if (is_string($filter) && preg_match('/^foal_year:(\d{4})$/', $filter, $matches) === 1) {
      return (int) $matches[1];
    }
  }
  return NULL;
}

/**
 * Whether the site search request has a category facet active for the given name.
 */
function wcf_theme_search_has_category_facet(string $category_name): bool {
  $term = wcf_theme_load_category_term_by_name($category_name);
  if ($term === NULL) {
    return FALSE;
  }
  $tid = (int) $term->id();

  $request = \Drupal::request();
  $category = $request->query->get('category');
  if ($category !== NULL && $category !== '') {
    $values = is_array($category) ? $category : [$category];
    foreach ($values as $value) {
      if (strcasecmp(trim((string) $value), $category_name) === 0) {
        return TRUE;
      }
    }
  }

  $filters = $request->query->all('f');
  if (!is_array($filters)) {
    return FALSE;
  }
  foreach ($filters as $filter) {
    if (!is_string($filter)) {
      continue;
    }
    if (preg_match('/^category:(\d+)$/', $filter, $matches) === 1) {
      return (int) $matches[1] === $tid;
    }
  }

  return FALSE;
}

/**
 * Whether the site search request has the Foals category facet active.
 */
function wcf_theme_search_has_foals_category(): bool {
  return wcf_theme_search_has_category_facet('Foals');
}

/**
 * Removes Search API conditions for a field from a condition group (recursive).
 */
function wcf_theme_search_api_query_remove_field_conditions(ConditionGroupInterface $group, string $field): void {
  $conditions = &$group->getConditions();
  foreach ($conditions as $key => $condition) {
    if ($condition instanceof ConditionGroupInterface) {
      wcf_theme_search_api_query_remove_field_conditions($condition, $field);
      if ($condition->isEmpty()) {
        unset($conditions[$key]);
      }
      continue;
    }
    if ($condition instanceof ConditionInterface && $condition->getField() === $field) {
      unset($conditions[$key]);
    }
  }
}

/**
 * Implements hook_search_api_query_alter().
 *
 * Legacy "For Sale" category facet: D7 used sold = 0, not category_id = 2 (all sold=1).
 */
function wcf_theme_search_api_query_alter(QueryInterface $query): void {
  if (!wcf_theme_search_has_category_facet('For Sale')) {
    return;
  }
  $group = $query->getConditionGroup();
  if ($group instanceof ConditionGroupInterface) {
    wcf_theme_search_api_query_remove_field_conditions($group, 'category');
  }
  $query->addCondition('status', 'active');
}

/**
 * Whether the current request is the site search page at /search.
 */
function wcf_theme_is_site_search_page(): bool {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['view.search_stallions.page_1', 'search.view'], TRUE)) {
    return TRUE;
  }
  return \Drupal::service('path.current')->getPath() === '/search';
}

/**
 * Whether foal year should show on stallion cards (site search + Foals facet only).
 */
function wcf_theme_show_foal_year_on_cards(): bool {
  return wcf_theme_is_site_search_page() && wcf_theme_search_has_foals_category();
}

/**
 * Builds foal year pill links for site search when Foals category is active.
 *
 * @return list<array{label: string, url: string, active: bool}>
 */
function wcf_theme_build_foal_search_year_links(): array {
  if (!wcf_theme_search_has_foals_category()) {
    return [];
  }

  $foals_term = wcf_theme_load_category_term_by_name('Foals');
  if ($foals_term === NULL) {
    return [];
  }

  $years = \Drupal::database()->query(
    'SELECT DISTINCT f.field_foal_year_value AS year
     FROM {node__field_foal_year} f
     INNER JOIN {node_field_data} n ON n.nid = f.entity_id
     INNER JOIN {node__field_category} c ON c.entity_id = n.nid
     WHERE n.type = :type AND n.status = 1
       AND c.field_category_target_id = :tid
       AND f.field_foal_year_value IS NOT NULL
     ORDER BY year DESC',
    [
      ':type' => 'stallion',
      ':tid' => (int) $foals_term->id(),
    ]
  )->fetchCol();

  if ($years === []) {
    return [];
  }

  $request = \Drupal::request();
  $active_year = wcf_theme_search_active_foal_year();
  $keywords = $request->query->get('keywords');

  $links = [];
  foreach ($years as $year) {
    $year = (int) $year;
    $query = [
      'category' => 'Foals',
      'f' => ["foal_year:$year"],
    ];
    if (is_string($keywords) && $keywords !== '') {
      $query['keywords'] = $keywords;
    }
    $url = wcf_theme_safe_route_url('view.search_stallions.page_1', [], ['query' => $query]);
    if ($url === NULL) {
      continue;
    }
    $links[] = [
      'label' => (string) $year,
      'url' => $url,
      'active' => $active_year === $year,
    ];
  }

  return $links;
}

/**
 * Implements hook_preprocess_node__stallion().
 */
function wcf_theme_preprocess_node__stallion(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }

  $variables['stallion_placeholder_image'] = wcf_theme_stallion_placeholder_image_url();
  $variables['stallion_sold_badge_image'] = wcf_theme_stallion_sold_badge_image_url();
  $variables['stallion_is_sold'] = wcf_theme_stallion_is_sold($node);
  // Full page: sold is indicated by the image badge only, not a text status line.
  $view_mode = $variables['view_mode'] ?? 'default';
  $variables['stallion_status_label'] = $view_mode === 'full'
    ? NULL
    : wcf_theme_stallion_card_status_label($node, $view_mode);
  $variables['stallion_featured'] = (bool) $node->get('field_featured')->value;
  $variables['stallion_summary_fallback'] = wcf_theme_stallion_summary_fallback($node, 120);
  $variables['node_summary_fallback'] = $variables['stallion_summary_fallback'];
  $variables['stallion_is_foals'] = wcf_theme_stallion_is_foals($node);
  $variables['stallion_foal_year'] = NULL;
  if (wcf_theme_show_foal_year_on_cards() && $variables['stallion_is_foals']) {
    $variables['stallion_foal_year'] = wcf_theme_stallion_foal_year($node);
    $variables['#cache']['contexts'] = Cache::mergeContexts(
      $variables['#cache']['contexts'] ?? [],
      ['url.query_args:category', 'url.query_args:f'],
    );
  }
  $variables['stallion_card_detail_line'] = NULL;
  $variables['stallion_display_name'] = NULL;
  if ($node->hasField('field_display_name') && !$node->get('field_display_name')->isEmpty()) {
    $variables['stallion_display_name'] = trim((string) $node->get('field_display_name')->value);
    if ($variables['stallion_display_name'] === '') {
      $variables['stallion_display_name'] = NULL;
    }
  }

  if ($variables['stallion_display_name'] !== NULL) {
    $variables['stallion_card_detail_line'] = wcf_theme_stallion_card_detail_line($node);
  }

  if (($variables['view_mode'] ?? '') === 'full') {
    $variables['stallion_nomination_cta_link'] = wcf_theme_stallion_shows_nomination_cta($node)
      ? wcf_theme_build_stallion_nomination_cta_link()
      : NULL;

    wcf_theme_attach_ad_banners($variables, $node);

    wcf_theme_attach_stallion_media_lightbox($variables, $node);

    $variables['stallion_document_items'] = wcf_theme_stallion_document_items($node);
    $variables['stallion_video_items'] = wcf_theme_stallion_video_items($node);
    if ($variables['stallion_video_items'] !== []) {
      $variables['stallion_video_group'] = wcf_theme_stallion_video_lightbox_group($node);
      $variables['#attached']['library'][] = 'wcf_theme/gallery-lightbox';
    }
  }
}

/**
 * Returns the GLightbox group id for stallion gallery images.
 */
function wcf_theme_stallion_media_lightbox_group(NodeInterface $node): string {
  return 'stallion-gallery-' . $node->id();
}

/**
 * Returns the GLightbox group id for stallion video rows.
 */
function wcf_theme_stallion_video_lightbox_group(NodeInterface $node): string {
  return 'stallion-video-' . $node->id();
}

/**
 * Attaches the stallion media lightbox library when gallery or video exists.
 */
function wcf_theme_attach_stallion_media_lightbox(array &$variables, NodeInterface $node): void {
  if ($node->get('field_gallery')->isEmpty() && $node->get('field_video')->isEmpty()) {
    return;
  }

  $variables['stallion_gallery_group'] = wcf_theme_stallion_media_lightbox_group($node);
  $variables['#attached']['library'][] = 'wcf_theme/gallery-lightbox';
}

/**
 * Implements hook_preprocess_field__node__field_gallery__stallion().
 */
function wcf_theme_preprocess_field__node__field_gallery__stallion(array &$variables): void {
  $node = $variables['element']['#object'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }

  wcf_theme_attach_stallion_media_lightbox($variables, $node);
  $variables['stallion_gallery_group'] = wcf_theme_stallion_media_lightbox_group($node);

  $total = count($variables['items']);
  foreach ($variables['items'] as $delta => &$item) {
    if (!isset($item['content']) || !is_array($item['content'])) {
      continue;
    }
    $item['content']['#stallion_gallery_group'] = $variables['stallion_gallery_group'];
    $item['content']['#stallion_gallery_index'] = $delta + 1;
    $item['content']['#stallion_gallery_total'] = $total;
  }
}

/**
 * Implements hook_preprocess_media__image__gallery().
 */
function wcf_theme_preprocess_media__image__gallery(array &$variables): void {
  wcf_theme_preprocess_media_gallery_lightbox($variables);
}

/**
 * Implements hook_preprocess_media__remote_video__gallery().
 */
function wcf_theme_preprocess_media__remote_video__gallery(array &$variables): void {
  wcf_theme_preprocess_media_gallery_lightbox($variables);
}

/**
 * Shared preprocess for stallion gallery / video lightbox media view modes.
 *
 * @param array<string, mixed> $variables
 *   Media preprocess variables.
 */
function wcf_theme_preprocess_media_gallery_lightbox(array &$variables): void {
  $elements = $variables['elements'] ?? [];
  $variables['stallion_gallery_group'] = $elements['#stallion_gallery_group'] ?? NULL;
  $variables['showcase_gallery_group'] = $elements['#showcase_gallery_group'] ?? NULL;
  $variables['stallion_gallery_index'] = $elements['#stallion_gallery_index'] ?? NULL;
  $variables['stallion_gallery_total'] = $elements['#stallion_gallery_total'] ?? NULL;

  if ($variables['stallion_gallery_group'] === NULL && $variables['showcase_gallery_group'] === NULL) {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof NodeInterface) {
      if ($node->bundle() === 'stallion') {
        $variables['stallion_gallery_group'] = wcf_theme_stallion_media_lightbox_group($node);
      }
      elseif ($node->bundle() === 'wcf_showcase_item') {
        $variables['showcase_gallery_group'] = wcf_theme_showcase_gallery_group($node);
      }
    }
  }
}

/**
 * Implements hook_preprocess_field__node__field_video__stallion().
 */
function wcf_theme_preprocess_field__node__field_video__stallion(array &$variables): void {
  $node = $variables['element']['#object'] ?? NULL;
  if ($node instanceof NodeInterface) {
    $variables['stallion_video_items'] = wcf_theme_stallion_video_items($node);
  }
}

/**
 * Returns the GLightbox group id for a showcase story node.
 */
function wcf_theme_showcase_gallery_group(NodeInterface $node): string {
  return 'showcase-' . $node->id();
}

/**
 * Implements hook_preprocess_node__wcf_showcase_item().
 */
function wcf_theme_preprocess_node__wcf_showcase_item(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->get('field_gallery')->isEmpty()) {
    return;
  }
  $variables['showcase_gallery_group'] = wcf_theme_showcase_gallery_group($node);
  $variables['#attached']['library'][] = 'wcf_theme/gallery-lightbox';
}

/**
 * Implements hook_preprocess_field__node__field_gallery__wcf_showcase_item().
 */
function wcf_theme_preprocess_field__node__field_gallery__wcf_showcase_item(array &$variables): void {
  $node = $variables['element']['#object'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  $group = wcf_theme_showcase_gallery_group($node);
  $variables['showcase_gallery_group'] = $group;
  $variables['stallion_gallery_group'] = $group;
  $variables['#attached']['library'][] = 'wcf_theme/gallery-lightbox';
  $total = count($variables['items']);
  foreach ($variables['items'] as $delta => &$item) {
    if (!isset($item['content']) || !is_array($item['content'])) {
      continue;
    }
    $item['content']['#showcase_gallery_group'] = $group;
    $item['content']['#stallion_gallery_group'] = $group;
    $item['content']['#stallion_gallery_index'] = $delta + 1;
    $item['content']['#stallion_gallery_total'] = $total;
  }
}

/**
 * Implements hook_preprocess_views_view__wcf_showcase().
 */
function wcf_theme_preprocess_views_view__wcf_showcase(array &$variables): void {
  $variables['#attached']['library'][] = 'wcf_theme/gallery-lightbox';
}

/**
 * Returns the public download URL for a newsletter node's document media.
 */
function wcf_theme_newsletter_file_url(NodeInterface $node): ?string {
  if ($node->bundle() !== 'wcf_newsletter' || !$node->hasField('field_newsletter_file') || $node->get('field_newsletter_file')->isEmpty()) {
    return NULL;
  }
  $media = $node->get('field_newsletter_file')->entity;
  if ($media === NULL || $media->bundle() !== 'document' || $media->get('field_media_document')->isEmpty()) {
    return NULL;
  }
  $file = $media->get('field_media_document')->entity;
  if ($file === NULL) {
    return NULL;
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
}

/**
 * Builds year-grouped newsletter rows for the /news accordion.
 *
 * @return list<array{year: int, items: list<array{month: string, title: string, url: string}>}>
 */
function wcf_theme_build_newsletter_year_groups(): array {
  $nids = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'wcf_newsletter')
    ->condition('status', 1)
    ->sort('field_newsletter_year', 'DESC')
    ->sort('field_newsletter_weight', 'ASC')
    ->execute();

  if ($nids === []) {
    return [];
  }

  $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
  $groups = [];
  foreach ($nodes as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }
    $url = wcf_theme_newsletter_file_url($node);
    if ($url === NULL) {
      continue;
    }
    $year = (int) $node->get('field_newsletter_year')->value;
    $month = trim((string) $node->get('field_newsletter_month')->value);
    if ($year <= 0 || $month === '') {
      continue;
    }
    $groups[$year]['year'] = $year;
    $groups[$year]['items'][] = [
      'month' => $month,
      'title' => $node->label(),
      'url' => $url,
    ];
  }

  krsort($groups, SORT_NUMERIC);
  return array_values($groups);
}

/**
 * Implements hook_preprocess_views_view__wcf_news().
 */
function wcf_theme_preprocess_views_view__wcf_news(array &$variables): void {
  $variables['wcf_newsletter_years'] = wcf_theme_build_newsletter_year_groups();
  $variables['#cache']['tags'][] = 'node_list:wcf_newsletter';
}

