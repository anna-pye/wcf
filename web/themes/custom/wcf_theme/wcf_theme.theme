/**
 * Allowed WCF palette tokens for registry fallback swatches.
 *
 * @return list<string>
 */
function wcf_theme_registry_colour_tokens(): array {
  return ['purple', 'coral', 'sky', 'lilac', 'gold', 'teal'];
}

/**
 * Normalises a registry colour token for CSS modifiers.
 */
function wcf_theme_registry_colour_tone(?string $value, string $default = 'purple'): string {
  $tone = $value !== NULL && $value !== '' ? $value : $default;
  return in_array($tone, wcf_theme_registry_colour_tokens(), TRUE) ? $tone : $default;
}

/**
 * Builds a registry logo image render array from uploaded media.
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_registry_logo_image(MediaInterface $media, string $alt): ?array {
  if ($media->bundle() !== 'image' || $media->get('field_media_image')->isEmpty()) {
    return NULL;
  }

  $file = $media->get('field_media_image')->entity;
  if ($file === NULL) {
    return NULL;
  }

  return [
    '#theme' => 'image_style',
    '#style_name' => 'medium',
    '#uri' => $file->getFileUri(),
    '#alt' => $alt,
    '#attributes' => [
      'class' => ['wcf-registry__logo'],
      'loading' => 'lazy',
      'decoding' => 'async',
    ],
    '#cache' => [
      'tags' => $media->getCacheTags(),
    ],
  ];
}

/**
 * Builds one homepage registry card from a registry logo node.
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_registry_logo_card(NodeInterface $node): ?array {
  if ($node->bundle() !== 'wcf_registry_logo' || !$node->isPublished()) {
    return NULL;
  }
  if (!$node->access('view')) {
    return NULL;
  }

  $name = $node->get('field_registry_name')->value;
  if ($name === NULL || trim($name) === '') {
    $name = $node->label();
  }
  $name = trim((string) $name);

  $short_raw = $node->get('field_registry_short_name')->value;
  $short_name = $short_raw !== NULL && trim($short_raw) !== '' ? trim($short_raw) : NULL;

  $tone = wcf_theme_registry_colour_tone(
    $node->get('field_registry_colour')->isEmpty() ? NULL : (string) $node->get('field_registry_colour')->value,
  );

  $logo = NULL;
  if (!$node->get('field_registry_logo')->isEmpty()) {
    $media = $node->get('field_registry_logo')->entity;
    if ($media instanceof MediaInterface) {
      $logo = wcf_theme_build_registry_logo_image($media, $name);
    }
  }

  $url = NULL;
  if (!$node->get('field_registry_link')->isEmpty()) {
    $link_item = $node->get('field_registry_link')->first();
    if ($link_item !== NULL) {
      $link_url = $link_item->getUrl();
      $url = wcf_theme_safe_url_string($link_url);
    }
  }

  return [
    'name' => $name,
    'short_name' => $short_name,
    'tone' => $tone,
    'logo' => $logo,
    'url' => $url,
  ];
}

/**
 * Static fallback registry cards when no published logo nodes exist.
 *
 * @return list<array<string, mixed>>
 */
function wcf_theme_homepage_registry_fallback_items(): array {
  return [
    [
      'name' => (string) t('Australian Studbook'),
      'short_name' => NULL,
      'tone' => 'purple',
      'logo' => NULL,
      'url' => NULL,
    ],
    [
      'name' => (string) t('Arabian Horse Society of Australia'),
      'short_name' => (string) t('AHSA'),
      'tone' => 'coral',
      'logo' => NULL,
      'url' => NULL,
    ],
    [
      'name' => (string) t('Australian Pony Stud Book Society / Riding Pony / Welsh Pony'),
      'short_name' => NULL,
      'tone' => 'sky',
      'logo' => NULL,
      'url' => NULL,
    ],
    [
      'name' => (string) t('Australian Stock Horse Society'),
      'short_name' => NULL,
      'tone' => 'lilac',
      'logo' => NULL,
      'url' => NULL,
    ],
    [
      'name' => (string) t('Australian Warmblood Horse Association'),
      'short_name' => (string) t('AWHA'),
      'tone' => 'gold',
      'logo' => NULL,
      'url' => NULL,
    ],
  ];
}

/**
 * Loads published registry logo nodes for the homepage bloodlines grid.
 *
 * @return array{items: list<array<string, mixed>>, cache_tags: list<string>}
 */
function wcf_theme_build_homepage_registry_items(): array {
  $cache_tags = ['node_list:wcf_registry_logo'];

  $nids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'wcf_registry_logo')
    ->condition('status', 1)
    ->sort('field_registry_weight', 'ASC')
    ->sort('title', 'ASC')
    ->range(0, 5)
    ->execute();

  if ($nids === []) {
    return [
      'items' => wcf_theme_homepage_registry_fallback_items(),
      'cache_tags' => $cache_tags,
    ];
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nodes = $storage->loadMultiple($nids);
  $items = [];

  foreach ($nids as $nid) {
    if (!isset($nodes[$nid])) {
      continue;
    }
    $card = wcf_theme_build_registry_logo_card($nodes[$nid]);
    if ($card === NULL) {
      continue;
    }
    $items[] = $card;
    $cache_tags = Cache::mergeTags($cache_tags, $nodes[$nid]->getCacheTags());
    if ($card['logo'] !== NULL && isset($card['logo']['#cache']['tags'])) {
      $cache_tags = Cache::mergeTags($cache_tags, $card['logo']['#cache']['tags']);
    }
  }

  if ($items === []) {
    return [
      'items' => wcf_theme_homepage_registry_fallback_items(),
      'cache_tags' => $cache_tags,
    ];
  }

  return [
    'items' => $items,
    'cache_tags' => $cache_tags,
  ];
}

/**
 * Canonical WCF Facebook page URL.
 */
function wcf_theme_facebook_page_url(): string {
  return 'https://www.facebook.com/pages/Winning-Colours-Farm/353221651451104';
}

/**
 * Public contact email for footer and site chrome.
 */
function wcf_theme_footer_contact_email(): string {
  $mail = \Drupal::config('system.site')->get('mail');
  if (is_string($mail) && $mail !== '') {
    return $mail;
  }

  return 'info@winningcoloursfarm.com.au';
}

/**
 * Facebook follow panel variables.
 *
 * @return array<string, mixed>
 */
function wcf_theme_build_homepage_social_follow(array $variables): array {
  $facebook_url = $variables['wcf_facebook_url'] ?? wcf_theme_facebook_page_url();

  return [
    'title' => (string) t('Love Our Horses?'),
    'text' => (string) t('Follow Winning Colours Farm for updates, foals, stallions and sale horses.'),
    'cta_label' => (string) t('Follow us on Facebook'),
    'url' => is_string($facebook_url) && $facebook_url !== '' ? $facebook_url : NULL,
  ];
}

/**
 * Front-page primary navigation (mockup-aligned).
 *
 * @return list<array<string, mixed>>
 */
function wcf_theme_build_front_nav_links(): array {
  $stallions_url = wcf_theme_build_stallions_listing_url('Stallions')
    ?? wcf_theme_safe_route_url('view.stallions.page_1')
    ?? '/stallions';
  $asb_url = wcf_theme_build_category_and_status_search_url('ASB Stallions', 'active') ?? $stallions_url;
  $for_sale_url = wcf_theme_build_category_search_url('For Sale') ?? wcf_theme_safe_route_url('view.search_stallions.page_1') ?? '/search';
  $foals_url = wcf_theme_build_category_and_status_search_url('Foals', 'active') ?? '/search';
  $nomination_url = wcf_theme_safe_route_url('entity.webform.canonical', ['webform' => 'wcf_nomination']) ?? '/nomination';
  $contact_url = wcf_theme_safe_route_url('entity.webform.canonical', ['webform' => 'wcf_contact']) ?? '/contact-us';
  $news_url = wcf_theme_safe_route_url('view.wcf_news.page_1') ?? '/news';

  $for_sale_children = array_values(array_filter([
    ['title' => (string) t('Brood Mares'), 'url' => wcf_theme_build_category_and_status_search_url('Broodmares', 'active') ?? ''],
    ['title' => (string) t('Show Mares'), 'url' => wcf_theme_build_category_and_status_search_url('Show Mares', 'active') ?? ''],
    ['title' => (string) t('Foals'), 'url' => wcf_theme_build_category_and_status_search_url('Foals', 'active') ?? ''],
    [
      'title' => (string) t('Stallions'),
      'url' => wcf_theme_build_categories_and_status_search_url(['ASB Stallions', 'Stallions'], 'active') ?? '',
    ],
  ], static fn(array $child): bool => ($child['url'] ?? '') !== ''));

  $items = [
    [
      'title' => (string) t('Stallions'),
      'url' => $stallions_url,
      'children' => [
        ['title' => (string) t('ASB Stallions'), 'url' => $asb_url],
        ['title' => (string) t('Stallions'), 'url' => $stallions_url],
      ],
    ],
    ['title' => (string) t('Foals'), 'url' => $foals_url],
    [
      'title' => (string) t('For Sale'),
      'url' => $for_sale_url,
      'children' => $for_sale_children,
    ],
    ['title' => (string) t('Nomination'), 'url' => $nomination_url],
    ['title' => (string) t('News'), 'url' => $news_url],
    ['title' => (string) t('Contact Us'), 'url' => $contact_url],
  ];

  return array_values(array_filter($items, static fn(array $item): bool => ($item['url'] ?? '') !== ''));
}

/**
 * Public footer utility links (same structure and URLs as header nav).
 *
 * @return list<array<string, mixed>>
 */
function wcf_theme_build_front_footer_links(): array {
  $home = [
    'title' => (string) t('Home'),
    'url' => wcf_theme_safe_internal_url('/') ?? '/',
  ];

  return array_values(array_filter(
    array_merge([$home], wcf_theme_build_front_nav_links()),
    static fn(array $item): bool => ($item['url'] ?? '') !== '',
  ));
}

/**
 * Attaches shared public footer variables (mockup layout on all pages).
 */
function wcf_theme_attach_public_footer_variables(array &$variables): void {
  $variables['wcf_front_footer_links'] = wcf_theme_build_front_footer_links();
  $variables['wcf_theme_logo_url'] = base_path() . \Drupal::theme()->getActiveTheme()->getPath() . '/logo.png';
  $variables['wcf_footer_contact_email'] = wcf_theme_footer_contact_email();
  $variables['wcf_home_social_follow'] = wcf_theme_build_homepage_social_follow($variables);
}

/**
 * Attaches shared public chrome variables (contact strip, header CTA).
 */
function wcf_theme_attach_chrome_variables(array &$variables): void {
  $site_config = \Drupal::config('system.site');
  $variables['wcf_site_mail'] = $site_config->get('mail');
  $variables['wcf_contact_phone_display'] = '0411 826 965';
  $variables['wcf_contact_phone_uri'] = 'tel:+61411826965';
  $variables['wcf_contact_strip_message'] = (string) t('Call Peta: @phone to discuss your future horse.', [
    '@phone' => '0411 826 965',
  ]);
  $variables['wcf_facebook_url'] = wcf_theme_facebook_page_url();
  $variables['wcf_instagram_url'] = wcf_theme_instagram_page_url();
  $variables['wcf_header_nomination_cta'] = wcf_theme_build_nomination_cta_link(
    (string) t('Nominate Your Mare'),
    ['site-chrome__cta-link'],
  );
