  $foals_url = wcf_theme_build_category_search_url('Foals');

  $items = [
    [
      'title' => (string) t('Quality Stallions'),
      'text' => (string) t('Carefully selected stallions with proven performance and outstanding pedigrees.'),
      'icon' => 'horse-head',
      'tone' => 'purple',
      'url' => wcf_theme_safe_route_url('view.stallions.page_1'),
    ],
    [
      'title' => (string) t('Foals & Youngstock'),
      'text' => (string) t('Beautiful foals bred for type, movement and trainability with bright futures.'),
      'icon' => 'foal',
      'tone' => 'coral',
      'url' => $foals_url ?? '',
    ],
    [
      'title' => (string) t('Nominate Your Mare'),
      'text' => (string) t('Give your mare the opportunity to produce her best foal yet this season.'),
      'icon' => 'document',
      'tone' => 'sky',
      'url' => $nomination_url,
    ],
    [
      'title' => (string) t('Container Homes'),
      'text' => (string) t('Quality, affordable and customisable container homes for any lifestyle.'),
      'icon' => 'home',
      'tone' => 'lilac',
      'url' => wcf_theme_safe_internal_url('/compliant-container-homes'),
    ],
    [
      'title' => (string) t('Get In Touch'),
      'text' => (string) t('Speak with Peta today about your stallion or future horse.'),
      'icon' => 'phone',
      'tone' => 'gold',
      'url' => wcf_theme_safe_route_url('entity.webform.canonical', ['webform' => 'wcf_contact']),
    ],
  ];

  return array_values(array_filter($items, static fn(array $item): bool => ($item['url'] ?? '') !== ''));
}

