/**
 * Builds the search active-filters summary without a block placement.
 *
 * @return array<string, mixed>|null
 *   Render array or NULL when empty / inaccessible.
 */
function wcf_theme_build_search_facets_summary(): ?array {
  $block_manager = \Drupal::service('plugin.manager.block');
  $plugin = $block_manager->createInstance('facets_summary_block:search_active_filters', []);
  if ($plugin === NULL || !$plugin->access(\Drupal::currentUser())) {
    return NULL;
  }

  $build = $plugin->build();
  if ($build === []) {
    return NULL;
  }

  $build['#contextual_links'] = [];

  return [
    '#type' => 'container',
    '#attributes' => ['class' => ['site-search__active-filters']],
    'inner' => [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['site-search__active-filters-inner'],
        'role' => 'status',
        'aria-live' => 'polite',
      ],
      'content' => $build,
    ],
  ];
}

/**
 * Implements hook_preprocess_views_view__search_stallions().
 */
function wcf_theme_preprocess_views_view__search_stallions(array &$variables): void {
  $variables['attributes']['class'][] = 'stallion-listing';
  $variables['attributes']['class'][] = 'site-search';
  $variables['#attached']['library'][] = 'wcf_theme/site-search';
  if (!empty($variables['header'])) {
    $variables['title'] = t('Search');
  }
  $variables['facets_summary'] = wcf_theme_build_search_facets_summary();

  $variables['stallion_foal_year_links'] = wcf_theme_show_foal_year_on_cards()
    ? wcf_theme_build_foal_search_year_links()
    : [];
}

/**
 * Implements hook_preprocess_page().
 */
function wcf_theme_preprocess_page__search(array &$variables): void {
  $variables['attributes']['class'][] = 'page--search';

  if (wcf_theme_search_has_foals_category()) {
    return;
  }

  if (isset($variables['page']['sidebar_first']['wcf_facet_foal_year'])) {
    unset($variables['page']['sidebar_first']['wcf_facet_foal_year']);
    $variables['#cache']['contexts'] = Cache::mergeContexts(
      $variables['#cache']['contexts'] ?? [],
      ['url.query_args:category', 'url.query_args:f'],
    );
  }
}

