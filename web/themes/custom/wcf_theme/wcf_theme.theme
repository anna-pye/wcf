<?php

/**
 * @file
 * Theme hooks for Winning Colours Farm.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\media\MediaInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\responsive_image\Entity\ResponsiveImageStyle;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\search_api\Query\ConditionGroupInterface;
use Drupal\search_api\Query\ConditionInterface;
use Drupal\search_api\Query\QueryInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;

/**
 * Builds an accessible CTA link render array from paragraph CTA fields.
 *
 * @return array<string, mixed>|null
 *   Link render array or NULL when no valid URL.
 */
function wcf_theme_build_paragraph_cta_link(ParagraphInterface $paragraph): ?array {
  if ($paragraph->get('field_cta_url')->isEmpty()) {
    return NULL;
  }

  $link_item = $paragraph->get('field_cta_url')->first();
  if ($link_item === NULL) {
    return NULL;
  }

  $url = $link_item->getUrl();
  if ($url->isRouted() && !$url->access()) {
    return NULL;
  }

  $cta_text = $paragraph->get('field_cta_text')->value;
  if ($cta_text === NULL || $cta_text === '') {
    $cta_text = $link_item->title ?: (string) t('Learn more');
  }

  return [
    '#type' => 'link',
    '#title' => $cta_text,
    '#url' => $url,
    '#attributes' => [
      'class' => ['feature-card__cta', 'button', 'button--primary'],
    ],
  ];
}

/**
 * Builds a nomination webform CTA link when the current user may access it.
 *
 * @param string|null $title
 *   Link text; defaults to stallion detail copy.
 * @param list<string> $classes
 *   Additional CSS classes.
 *
 * @return array<string, mixed>|null
 *   Link render array or NULL when the webform is unavailable.
 */
function wcf_theme_build_nomination_cta_link(?string $title = NULL, array $classes = []): ?array {
  $url = Url::fromRoute('entity.webform.canonical', ['webform' => 'wcf_nomination']);
  if ($url->isRouted() && !$url->access()) {
    return NULL;
  }

  $link_classes = array_merge(['button', 'button--primary'], $classes);

  return [
    '#type' => 'link',
    '#title' => $title ?? (string) t('Nominate this stallion'),
    '#url' => $url,
    '#attributes' => [
      'class' => $link_classes,
    ],
    '#cache' => [
      'tags' => ['config:webform.webform.wcf_nomination'],
    ],
  ];
}

/**
 * Builds the stallion detail nomination CTA link render array.
 *
 * @return array<string, mixed>|null
 *   Link render array or NULL when the webform is unavailable.
 */
function wcf_theme_build_stallion_nomination_cta_link(): ?array {
  return wcf_theme_build_nomination_cta_link((string) t('Nominate this stallion'), ['stallion__nomination-cta']);
}

/**
 * Whether the stallion detail page should show the nomination CTA.
 *
 * Shown only for standing inventory (Stallions or ASB Stallions) that is not sold.
 */
function wcf_theme_stallion_shows_nomination_cta(NodeInterface $node): bool {
  if ($node->bundle() !== 'stallion') {
    return FALSE;
  }
  if ($node->get('field_status')->value === 'sold') {
    return FALSE;
  }
  if ($node->get('field_category')->isEmpty()) {
    return FALSE;
  }
  $term = $node->get('field_category')->entity;
  if ($term === NULL) {
    return FALSE;
  }

  return in_array($term->label(), ['Stallions', 'ASB Stallions'], TRUE);
}

/**
 * Category term IDs for nomination stallion choices (Stallions, ASB Stallions).
 *
 * @return array<string, int>
 *   Keys are category labels, values are term IDs.
 */
function wcf_theme_nomination_stallion_category_term_ids(): array {
  static $cache = NULL;
  if ($cache !== NULL) {
    return $cache;
  }

  $cache = [];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (['Stallions', 'ASB Stallions'] as $label) {
    $tids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', 'categories')
      ->condition('name', $label)
      ->range(0, 1)
      ->execute();
    if ($tids !== []) {
      $cache[$label] = (int) reset($tids);
    }
  }

  return $cache;
}

/**
 * Human-readable label for a stallion on the nomination form.
 */
function wcf_theme_stallion_nomination_label(NodeInterface $node): string {
  if ($node->hasField('field_display_name') && !$node->get('field_display_name')->isEmpty()) {
    $name = trim((string) $node->get('field_display_name')->value);
    if ($name !== '') {
      return $name;
    }
  }

  return $node->label();
}

/**
 * Select options for active standing stallions (Stallions + ASB Stallions).
 *
 * @return array<int|string, string|array<int|string, string>>
 *   Options suitable for a #type select element (may use optgroups).
 */
function wcf_theme_nomination_stallion_options(bool $include_empty = TRUE): array {
  $category_ids = wcf_theme_nomination_stallion_category_term_ids();
  if ($category_ids === []) {
    return $include_empty ? ['' => (string) t('- Select -')] : [];
  }

  $nids = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'stallion')
    ->condition('status', 1)
    ->condition('field_status', 'active')
    ->condition('field_category', array_values($category_ids), 'IN')
    ->sort('title')
    ->execute();

  $grouped = [];
  $nodes = $nids !== [] ? \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids) : [];
  foreach ($nodes as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }
    $term = $node->get('field_category')->entity;
    $category = $term instanceof TermInterface ? $term->label() : (string) t('Stallions');
    $label = wcf_theme_stallion_nomination_label($node);
    $grouped[$category][$label] = $label;
  }

  $flat = [];
  $category_order = ['Stallions', 'ASB Stallions'];
  foreach ($category_order as $category) {
    if (empty($grouped[$category])) {
      continue;
    }
    ksort($grouped[$category], SORT_NATURAL | SORT_FLAG_CASE);
    foreach ($grouped[$category] as $label => $value) {
      $flat[$label] = $value;
    }
  }

  foreach ($grouped as $category => $items) {
    if (in_array($category, $category_order, TRUE)) {
      continue;
    }
    ksort($items, SORT_NATURAL | SORT_FLAG_CASE);
    foreach ($items as $label => $value) {
      $flat[$label] = $value;
    }
  }

  $options = $include_empty ? ['' => (string) t('- Select -')] : [];
  return $options + $flat;
}

/**
 * Flat list of allowed submitted values for preferred_stallion.
 *
 * @return list<string>
 */
function wcf_theme_nomination_stallion_allowed_values(): array {
  $allowed = [];
  foreach (wcf_theme_nomination_stallion_options(FALSE) as $key => $value) {
    if (is_array($value)) {
      foreach ($value as $option_key => $option_label) {
        $allowed[] = is_int($option_key) ? (string) $option_label : (string) $option_key;
      }
    }
    else {
      $allowed[] = is_int($key) ? (string) $value : (string) $key;
    }
  }

  return array_values(array_unique($allowed));
}

/**
 * Applies dynamic stallion options after the webform element is built.
 */
function wcf_theme_webform_preferred_stallion_after_build(array $element, \Drupal\Core\Form\FormStateInterface $form_state): array {
  $element['#options'] = wcf_theme_nomination_stallion_options();
  return $element;
}

/**
 * Alters the preferred stallion element in a webform render array (recursive).
 */
function wcf_theme_webform_alter_preferred_stallion_element(array &$form): bool {
  if (isset($form['preferred_stallion']) && is_array($form['preferred_stallion'])) {
    $form['preferred_stallion']['#type'] = 'select';
    $form['preferred_stallion']['#options'] = wcf_theme_nomination_stallion_options();
    $form['preferred_stallion']['#validated'] = TRUE;
    $form['preferred_stallion']['#after_build'][] = 'wcf_theme_webform_preferred_stallion_after_build';
    $form['preferred_stallion']['#element_validate'][] = 'wcf_theme_webform_nomination_validate_preferred_stallion';
    $form['preferred_stallion']['#cache'] = [
      'tags' => Cache::mergeTags(
        ['node_list:stallion'],
        array_map(
          static fn (int $tid): string => 'taxonomy_term:' . $tid,
          array_values(wcf_theme_nomination_stallion_category_term_ids()),
        ),
      ),
      'contexts' => ['user.permissions'],
    ];
    return TRUE;
  }

  foreach (Element::children($form) as $child_key) {
    if (!is_array($form[$child_key])) {
      continue;
    }
    if (wcf_theme_webform_alter_preferred_stallion_element($form[$child_key])) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Alters the nomination webform preferred stallion field into a dynamic select.
 */
function wcf_theme_webform_nomination_form_alter(array &$form): void {
  wcf_theme_webform_alter_preferred_stallion_element($form);
}

/**
 * Validates that the preferred stallion choice is from the current standing list.
 */
function wcf_theme_webform_nomination_validate_preferred_stallion(array &$element, \Drupal\Core\Form\FormStateInterface $form_state, array &$form): void {
  $value = trim((string) ($element['#value'] ?? ''));
  if ($value === '') {
    return;
  }

  if (!in_array($value, wcf_theme_nomination_stallion_allowed_values(), TRUE)) {
    $form_state->setError($element, (string) t('Please select a valid stallion from the list.'));
  }
}

/**
 * Governed category labels for the stallions listing and search facets.
 *
 * @return list<string>
 */
function wcf_theme_stallion_listing_category_labels(): array {
  return [
    'ASB Stallions',
    'Stallions',
    'Sold Stallions',
  ];
}

/**
 * Taxonomy term IDs for stallion listing category filters (by label).
 *
 * @return list<int>
 */
function wcf_theme_stallion_listing_category_term_ids(): array {
  static $cache = NULL;
  if ($cache !== NULL) {
    return $cache;
  }

  $cache = [];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (wcf_theme_stallion_listing_category_labels() as $label) {
    $tids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', 'categories')
      ->condition('name', $label)
      ->range(0, 1)
      ->execute();
    if ($tids !== []) {
      $cache[] = (int) reset($tids);
    }
  }

  return $cache;
}

/**
 * Restricts exposed category options on the stallions listing.
 */
function wcf_theme_limit_stallion_listing_category_options(array &$form): void {
  if (!isset($form['stallion_category']['#options']) || !is_array($form['stallion_category']['#options'])) {
    return;
  }

  $allowed = array_fill_keys(wcf_theme_stallion_listing_category_term_ids(), TRUE);
  $filtered = [];
  foreach ($form['stallion_category']['#options'] as $key => $label) {
    if ($key === '' || $key === 'All' || $key === '_none') {
      $filtered[$key] = $label;
      continue;
    }
    if (isset($allowed[(int) $key])) {
      $filtered[$key] = $label;
    }
  }
  $form['stallion_category']['#options'] = $filtered;
}

/**
 * Applies WCF exposed-filter styling on the stallions listing page.
 */
function wcf_theme_stallion_listing_exposed_form_alter(array &$form): void {
  $form['#attributes']['class'][] = 'stallion-listing-page__form';
  $form['#attributes']['role'] = 'search';
  $form['#attributes']['aria-label'] = (string) t('Filter stallions');

  foreach (['stallion_status', 'stallion_category'] as $field) {
    if (!isset($form[$field])) {
      continue;
    }
    $form[$field]['#attributes']['class'][] = 'stallion-listing-page__select';
  }

  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'button--primary';
    $form['actions']['submit']['#attributes']['class'][] = 'stallion-listing-page__apply';
    $form['actions']['submit']['#value'] = (string) t('Apply');
  }
  if (isset($form['actions']['reset'])) {
    $form['actions']['reset']['#attributes']['class'][] = 'button--outline';
    $form['actions']['reset']['#attributes']['class'][] = 'stallion-listing-page__reset';
  }
}

/**
 * Builds a link render array when the route exists and is accessible.
 *
 * @param array<string, mixed> $options
 *   Url::fromRoute() options (e.g. query).
 * @param list<string> $classes
 *   CSS classes on the anchor.
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_route_link(string $route_name, array $route_parameters, string $title, array $classes = [], array $options = []): ?array {
  try {
    $url = Url::fromRoute($route_name, $route_parameters, $options);
  }
  catch (\Exception) {
    return NULL;
  }

  if ($url->isRouted() && !$url->access()) {
    return NULL;
  }

  $link = [
    '#type' => 'link',
    '#title' => $title,
    '#url' => $url,
    '#attributes' => [
      'class' => $classes,
    ],
  ];

  if ($url->isRouted()) {
    $link['#cache']['contexts'][] = 'user.permissions';
  }

  return $link;
}

/**
 * Returns a string URL when the URL is accessible, or NULL.
 */
function wcf_theme_safe_url_string(Url $url): ?string {
  if ($url->isRouted() && !$url->access()) {
    return NULL;
  }

  return $url->toString();
}

/**
 * Returns a route URL string when accessible.
 */
function wcf_theme_safe_route_url(string $route_name, array $route_parameters = [], array $options = []): ?string {
  try {
    $url = Url::fromRoute($route_name, $route_parameters, $options);
  }
  catch (\Exception) {
    return NULL;
  }

  return wcf_theme_safe_url_string($url);
}

/**
 * Returns an internal path URL string when accessible.
 */
function wcf_theme_safe_internal_url(string $path, array $options = []): ?string {
  try {
    $url = Url::fromUserInput($path, $options);
  }
  catch (\Exception) {
    return NULL;
  }

  return wcf_theme_safe_url_string($url);
}

/**
 * Builds a link from an internal path when accessible.
 *
 * @param list<string> $classes
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_internal_path_link(string $path, string $title, array $classes = [], array $options = []): ?array {
  try {
    $url = Url::fromUserInput($path, $options);
  }
  catch (\Exception) {
    return NULL;
  }

  if (!$url->access()) {
    return NULL;
  }

  return [
    '#type' => 'link',
    '#title' => $title,
    '#url' => $url,
    '#attributes' => [
      'class' => $classes,
    ],
    '#cache' => [
      'contexts' => ['user.permissions'],
    ],
  ];
}

/**
 * Returns the front-page homepage node, if configured and viewable.
 */
function wcf_theme_load_front_homepage_node(): ?NodeInterface {
  $front = (string) \Drupal::config('system.site')->get('page.front');
  if (!preg_match('/^\/node\/(\d+)$/', $front, $matches)) {
    return NULL;
  }

  $node = \Drupal::entityTypeManager()->getStorage('node')->load((int) $matches[1]);
  if (!$node instanceof NodeInterface || $node->bundle() !== 'homepage' || !$node->isPublished()) {
    return NULL;
  }
  if (!$node->access('view')) {
    return NULL;
  }

  return $node;
}

/**
 * Public URL for a theme image under images/.
 */
function wcf_theme_theme_image_url(string $relative_path): string {
  return base_path() . \Drupal::theme()->getActiveTheme()->getPath() . '/images/' . ltrim($relative_path, '/');
}

/**
 * Public URL for the homepage hero background image.
 */
function wcf_theme_home_hero_image_url(): string {
  return wcf_theme_theme_image_url('home-hero-broodmares.jpg');
}

/**
 * Builds hero background image render array for the front page.
 *
 * @return array<string, mixed>|null
 */
function wcf_theme_build_homepage_hero_background(): ?array {
  return [
    '#type' => 'html_tag',
    '#tag' => 'img',
    '#attributes' => [
      'class' => ['wcf-home-hero__image'],
      'src' => wcf_theme_home_hero_image_url(),
      'alt' => (string) t('Two Winning Colours Farm broodmares trotting on the track'),
      'width' => '1024',
      'height' => '689',
      'loading' => 'eager',
      'fetchpriority' => 'high',
      'decoding' => 'async',
    ],
    '#cache' => [
      'tags' => ['config:system.site'],
      'contexts' => ['languages:language_interface'],
    ],
  ];
}

/**
 * Attaches homepage mockup variables for the front page.
 */
function wcf_theme_attach_homepage_variables(array &$variables): void {
  $stallions_link = wcf_theme_build_route_link(
    'view.stallions.page_1',
    [],
    (string) t('Our Stallions'),
    ['button', 'button--primary', 'wcf-home-hero__button'],
  );
  $search_link = wcf_theme_build_category_search_link(
    'For Sale',
    (string) t('Browse For Sale'),
    ['button', 'button--ghost', 'wcf-home-hero__button'],
  ) ?? wcf_theme_build_route_link(
    'view.search_stallions.page_1',
    [],
    (string) t('Browse For Sale'),
    ['button', 'button--ghost', 'wcf-home-hero__button'],
  );

  $hero_actions = array_values(array_filter([$stallions_link, $search_link]));

  $variables['wcf_home_hero'] = [
    'logo_url' => base_path() . \Drupal::theme()->getActiveTheme()->getPath() . '/logo.png',
    'heading_line_1' => (string) t('PROVEN BLOODLINES.'),
    'heading_line_2' => (string) t('BRIGHTER FUTURES.'),
    'intro' => (string) t('At Winning Colours Farm, we are passionate about producing quality horses with exceptional temperament, conformation and performance.'),
    'background' => wcf_theme_build_homepage_hero_background(),
    'actions' => $hero_actions,
    '#cache' => [
      'tags' => ['config:system.site'],
      'contexts' => ['user.permissions', 'languages:language_interface'],
    ],
  ];

  $feature_links = wcf_theme_build_homepage_feature_links();
  $variables['wcf_home_feature_links'] = $feature_links;
  foreach (['Foals', 'For Sale'] as $category_name) {
    $term = wcf_theme_load_category_term_by_name($category_name);
    if ($term !== NULL) {
      $variables['#cache']['tags'] = Cache::mergeTags(
        $variables['#cache']['tags'] ?? [],
        $term->getCacheTags(),
      );
    }
  }
  $variables['wcf_home_promo_cards'] = wcf_theme_build_homepage_promo_cards();
  $registry = wcf_theme_build_homepage_registry_items();
  $variables['wcf_home_registry_items'] = $registry['items'];
  if (!empty($registry['cache_tags'])) {
    $variables['#cache']['tags'] = Cache::mergeTags(
      $variables['#cache']['tags'] ?? [],
      $registry['cache_tags'],
    );
  }
}

