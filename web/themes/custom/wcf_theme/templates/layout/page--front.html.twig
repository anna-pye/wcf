{#
/**
 * @file
 * Front page layout — mockup homepage sections with shared public chrome.
 */
#}
<div class="layout-container layout-container--front">
  {% include '@wcf_theme/layout/partials/wcf-public-header.html.twig' %}

  <main id="main-content" class="site-main site-main--front" role="main">
    {{ page.highlighted }}

    {% include '@wcf_theme/components/wcf-home-hero.html.twig' %}
    {% include '@wcf_theme/components/wcf-home-feature-strip.html.twig' %}
    {% include '@wcf_theme/components/wcf-home-promo-cards.html.twig' %}
    {% include '@wcf_theme/components/wcf-home-lower-band.html.twig' %}

    {% set homepage_cms = page.content|render|striptags|trim %}
    {% if homepage_cms is not empty %}
      <div class="layout-content layout-content--front">
        {{ page.content }}
      </div>
    {% endif %}
  </main>

  {% include '@wcf_theme/layout/partials/wcf-public-footer.html.twig' %}
</div>
