{#
/**
 * @file
 * Base page layout for WCF — D7-inspired public chrome.
 */
#}
<div class="layout-container layout-container--inner">
  <header class="site-header" role="banner">
    <div class="site-chrome site-chrome--inner">
      {% if page.header %}
        <div class="site-chrome__identity">
          {{ page.header }}
        </div>
      {% endif %}
      {% if page.primary_menu or page.secondary_menu %}
        <details class="site-chrome__nav-drawer">
          <summary class="site-chrome__nav-toggle">
            <span class="site-chrome__nav-toggle-label">{{ 'Menu'|t }}</span>
          </summary>
          <div class="site-chrome__nav-panel">
            <nav class="site-chrome__nav" aria-label="{{ 'Main navigation'|t }}">
              {% if page.primary_menu %}
                {{ page.primary_menu }}
              {% endif %}
              {% if page.secondary_menu %}
                {{ page.secondary_menu }}
              {% endif %}
            </nav>
          </div>
        </details>
      {% endif %}
    </div>
  </header>

  {{ page.breadcrumb }}

  <main id="main-content" class="site-main" role="main">
    {{ page.highlighted }}
    {{ page.help }}
    <div class="layout-content{% if page.sidebar_first %} layout-content--with-sidebar{% endif %}">
      {% if page.sidebar_first %}
        <aside class="layout-sidebar layout-sidebar--first" aria-label="{{ 'Filters'|t }}">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}
      <div class="layout-content__primary">
        {{ page.content }}
      </div>
    </div>
    {{ page.sidebar_second }}
  </main>

  {% if page.footer or site_mail %}
    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        {% if page.footer %}
          <div class="site-footer__menus">
            {{ page.footer }}
          </div>
        {% endif %}
        <div class="site-footer__meta">
          {% if site_mail %}
            <p class="site-footer__contact">
              <span class="site-footer__contact-label">{{ 'Web site contact'|t }}</span>
              <a href="mailto:{{ site_mail }}">{{ site_mail }}</a>
            </p>
          {% endif %}
          <p class="site-footer__branding">
            <a href="{{ front_page }}" class="site-footer__site-name">{{ site_name }}</a>
          </p>
          <p class="site-footer__copyright">
            &copy; {{ "now"|date("Y") }} {{ site_name }}. {{ 'All rights reserved.'|t }}
          </p>
        </div>
      </div>
    </footer>
  {% endif %}
</div>
