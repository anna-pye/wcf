{#
/**
 * @file
 * Base page layout — shared WCF public chrome on all customer-facing pages.
 */
#}
<div class="layout-container layout-container--inner">
  {% include '@wcf_theme/layout/partials/wcf-public-header.html.twig' %}

  {{ page.breadcrumb }}

  <main id="main-content" class="site-main" role="main">
    {{ page.highlighted }}
    {{ page.help }}
    <div class="layout-content{% if page.sidebar_first %} layout-content--with-sidebar{% endif %}">
      {% if page.sidebar_first %}
        <aside class="layout-sidebar layout-sidebar--first" aria-label="{{ 'Filters'|t }}">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}
      <div class="layout-content__primary">
        {{ page.content }}
      </div>
    </div>
    {{ page.sidebar_second }}
  </main>

  {% include '@wcf_theme/layout/partials/wcf-public-footer.html.twig' %}
</div>
