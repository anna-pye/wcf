{#
/**
 * @file
 * Stallion gallery — horizontal D7-style cards + GLightbox slideshow (D7 fancybox rel="group").
 */
#}
{% if items %}
  <ul class="stallion-gallery__grid" role="list" data-gallery-group="{{ stallion_gallery_group }}">
    {% for item in items %}
      <li class="stallion-gallery__item" role="listitem">
        <div class="stallion-gallery__card">
          {{ item.content }}
        </div>
      </li>
    {% endfor %}
  </ul>
{% endif %}
