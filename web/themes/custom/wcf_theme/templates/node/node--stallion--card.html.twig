{#
/**
 * @file
 * Stallion card view mode — delegates to stallion-card component.
 */
#}
{% include '@wcf_theme/components/stallion-card.html.twig' with {
  node: node,
  url: url,
  title: stallion_display_name|default(label),
  foal_year: stallion_foal_year,
  detail_line: stallion_card_detail_line,
  subtitle: stallion_display_name ? label : null,
  image: node.field_main_image.isEmpty() ? null : content.field_main_image,
  placeholder_image: node.field_main_image.isEmpty() ? stallion_placeholder_image : null,
  summary: content.body,
  summary_fallback: stallion_summary_fallback,
  status: stallion_is_sold ? null : stallion_status_label,
  is_sold: stallion_is_sold,
  sold_badge_image: stallion_sold_badge_image,
  featured: stallion_featured,
} only %}
