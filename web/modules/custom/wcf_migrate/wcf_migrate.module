<?php

/**
 * @file
 * WCF controlled migration framework hooks.
 */

use Drupal\Core\Site\Settings;

/**
 * Implements hook_migration_plugins_alter().
 */
function wcf_migrate_migration_plugins_alter(array &$migrations): void {
  $base_path = Settings::get('migrate_file_public_path');
  if (!$base_path) {
    return;
  }
  $base_path = rtrim($base_path, '/');
  foreach ($migrations as $id => &$migration) {
    if (!str_starts_with($id, 'wcf_')) {
      continue;
    }
    foreach (['source_base_path', 'product_files_base_path'] as $constant) {
      if (isset($migration['source']['constants'][$constant])
        && $migration['source']['constants'][$constant] === '') {
        $migration['source']['constants'][$constant] = $base_path;
      }
    }
  }
}
