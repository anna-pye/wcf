# macOS
.DS_Store

# Composer
/vendor/

# Drupal core and contrib (Composer-managed)
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Drupal files
/web/sites/*/files/
/web/sites/*/private/
/web/sites/default/files/
/web/sites/default/private/

# Drupal settings overrides (environment-specific)
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml
/web/sites/default/settings.php
/web/sites/default/services.yml

# DDEV
/.ddev/.global_commands/
/.ddev/.importdb*/
/.ddev/.downloads/
.ddev/.importdbCommand
.ddev/db_snapshots
.ddev/.dbimageBuild
.ddev/.webimageBuild

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log
yarn-error.log

# Environment
.env

# Node
node_modules/
/web/themes/custom/wcf_theme/node_modules/

# Sass cache
.sass-cache/

# Temporary
tmp/
temp/

# PHPUnit
phpunit.xml
.phpunit.result.cache

# Legacy migration assets - local only
/legacy/sites/default/files/

# Theme build artifacts
/web/themes/custom/wcf_theme/css/*.map
